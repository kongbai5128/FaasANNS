{
  "server": {
    "host": "0.0.0.0",
    "port": 8080,
    "log_level": "info",
    "workers": 3,
    "worker_healthcheck_timeout_seconds": 120
  },
  "dataset": {
    "base_path": "data/gist/gist_base.fvecs",
    "dimension": 960,
    "max_vectors": 1000000
  },
  "search": {
    "hnsw": {
      "default_k": 10,
      "candidate_k": 500,
      "hnsw_index_path": "data/gist/index/full/full_hnsw.bin",
      "hnsw_m": 32,
      "hnsw_ef_construction": 200,
      "hnsw_ef_search": 500
    },
    "pipeline": {
      "local_search_workers": 2,
      "faas_invoke_workers": 1000,
      "rerank_workers": 10
    },
    "offload_qps_threshold": 10,
    "force_faas": false
  },
  "scaling": {
    "prewarm_check_seconds": 600.0,
    "load_index_timeout_seconds": 600.0,
    "enable_prewarm": false,
    "local_candidate_ms": 8.0,
    "remote_candidate_ms": 20.0,
    "function_concurrency": 20,
    "max_warm_functions": 32,
    "function_memory_mb": 512,
    "cost_per_gb_second": 0.0000167,
    "adaptive_offload_enabled": true,
    "adaptive_control_interval_seconds": 1.0,
    "adaptive_target_local_utilization": 0.7,
    "adaptive_ratio_step_up": 0.1,
    "adaptive_ratio_step_down": 0.25,
    "adaptive_ratio_hysteresis": 0.03,
    "adaptive_max_faas_ratio": 0.9,
    "adaptive_remote_p95_limit_ms": 300.0,
    "adaptive_faas_error_rate_threshold": 0.02,
    "adaptive_circuit_breaker_seconds": 15.0,
    "adaptive_min_latency_samples": 20
  },
  "faas": {
    "provider": "aliyun_http",
    "invoke_timeout_seconds": 600.0,
    "warmup_timeout_seconds": 600.0,
    "endpoints": {
      "default": "https://vector-search-qpvucermgx.cn-hongkong-vpc.fcapp.run"
    }
  }
}
